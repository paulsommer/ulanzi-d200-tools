# Ulanzi D200 plugged in: start the user unit d200-wide-black.service,
# which makes d200-focus send the black wide display background again.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2207", ATTR{idProduct}=="0019", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="d200-wide-black.service"
