#!/usr/bin/python3
"""d200-raise - bring a running application to the front, or start it.

Used by the Ulanzi D200 layouts as a "command" action for program keys. Starting
Firefox, Konsole, Dolphin or Kate a second time opens another window, which is
not wanted on a key: a running program should only be brought to the front.

KDE Wayland does not let normal programs list or activate windows, so a one-shot
KWin script does that and reports back via D-Bus whether a window was found:
- no window of the program: the command is started
- a window of the program is active: the next one is activated (round robin)
- otherwise: the most recently active window is activated

Usage:  d200-raise <name> [command ...]
        <name> is matched against the window class like in d200-focus
        (org.kde.dolphin matches "dolphin"); command defaults to <name>.
"""

import os
import subprocess
import sys
from pathlib import Path

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

VERSION = "1.0.0"
INTERFACE = "io.github.paulsommer.D200Raise"
# Time KWin gets to run the script and call back
TIMEOUT_MS = 2000

# Bottom-to-top stacking order: the last match is the most recently active window.
# Activating the bottom match while one of them is active cycles through all of them,
# because the activated window moves to the top.
KWIN_SCRIPT = """
var name = "{name}";
var matches = workspace.stackingOrder.filter(function (w) {{
    var cls = String(w.resourceClass).toLowerCase();
    return w.normalWindow && (cls === name || cls.split(".").pop() === name);
}});
var target = null;
if (matches.length > 0)
    target = matches.indexOf(workspace.activeWindow) >= 0 ? matches[0] : matches[matches.length - 1];
if (target) {{
    target.minimized = false;
    workspace.activeWindow = target;
}}
callDBus("{bus_name}", "/", "{interface}", "result", target !== null);
"""


class ResultReceiver(dbus.service.Object):
    """D-Bus object called back by the KWin script with the search result."""

    # --------------------------------------------------------------------------
    def __init__(self, bus: dbus.SessionBus, loop: GLib.MainLoop):
        """Register the object on the private connection of this process."""
        super().__init__(bus, "/")
        self.loop = loop
        self.found = None

    # --------------------------------------------------------------------------
    @dbus.service.method(INTERFACE, in_signature="b")
    def result(self, found: bool):
        """Store the result and stop waiting.

        Args:
            found: True if a window was activated, False if none matched.
        """
        self.found = bool(found)
        self.loop.quit()


# --------------------------------------------------------------------------
def main() -> None:
    """Run the KWin script, then start the command if no window was found."""
    if len(sys.argv) < 2:
        print("Usage: d200-raise <name> [command ...]   e.g. d200-raise dolphin", file=sys.stderr)
        sys.exit(2)
    name = sys.argv[1].lower()
    command = sys.argv[2:] or [sys.argv[1]]

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    loop = GLib.MainLoop()
    receiver = ResultReceiver(bus, loop)

    plugin = f"d200-raise-{os.getpid()}"
    path = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / f"{plugin}.js"
    path.write_text(KWIN_SCRIPT.format(name=name, bus_name=bus.get_unique_name(), interface=INTERFACE))
    scripting = dbus.Interface(bus.get_object("org.kde.KWin", "/Scripting"), "org.kde.kwin.Scripting")
    try:
        # loadScript is overloaded, so the two-argument variant must be selected explicitly
        scripting.loadScript(str(path), plugin, signature="ss")
        scripting.start()
        GLib.timeout_add(TIMEOUT_MS, loop.quit)
        loop.run()
    finally:
        scripting.unloadScript(plugin)
        path.unlink()

    if receiver.found is None:
        print(f"d200-raise: no answer from KWin for '{name}'", file=sys.stderr)
        sys.exit(1)
    if not receiver.found:
        # Own scope: ulanzi-daemon is restarted on every layout switch and would
        # otherwise take the started program down with its control group
        subprocess.Popen(["systemd-run", "--user", "--scope", "--quiet", "--", *command],
                         start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
